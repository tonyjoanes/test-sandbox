<?xml version="1.0" encoding="utf-8"?>
<!-- VSTest-era coverage settings for Orders.Api.Tests (coverlet.collector).
     These tests host the whole API in memory, so the domain code runs too; Include keeps this
     project's numbers to the API assembly. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Orders.Api]*</Include>
          <ExcludeByFile>**/Program.cs,**/obj/**</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
